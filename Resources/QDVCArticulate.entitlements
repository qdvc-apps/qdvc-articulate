<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  QDVC Articulate entitlements.

  PRIVACY GUARANTEE: the App Sandbox is ON and there is deliberately NO
  com.apple.security.network.client and NO com.apple.security.network.server
  entitlement. Without them, macOS denies every network socket the process
  (or any library it loads) tries to open. Do not add network entitlements.

  scripts/verify-isolation.sh fails the build if either key ever appears.
-->
<plist version="1.0">
<dict>
	<!-- Required: confine the app. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Open/save documents and pick a GGUF model through the standard file dialogs. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- Remember the chosen GGUF model between launches (security-scoped bookmark). -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
